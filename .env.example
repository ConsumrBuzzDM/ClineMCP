# ClineMCP service config
MCP_PORT=8011
# Bind host (default 127.0.0.1). Set to 0.0.0.0 or a Tailscale/LAN IP only if remote clients need access.
MCP_HOST=127.0.0.1
INSTANCE_ROLE=development
# Required: requests are rejected (401) if no token is configured.
CLINEMCP_AUTH_TOKEN=change_me_in_dot_env_local
# CLINEMCP_ALLOW_NO_AUTH=1  # Development only: explicitly disable auth when no token is set

# Cline
CLINE_PATH=C:\Users\cheat\AppData\Roaming\npm\cline.cmd
CLINE_TIMEOUT_SECONDS=300
CLINE_DEFAULT_MODEL=qwen2.5-coder:7b
# CLINE_DEFAULT_CWD=C:\Github\DuggerBot  # Optional: Defaults to current directory if not set

# Telegram (optional - notifications disabled if not configured)
# TELEGRAM_BOT_TOKEN=your_bot_token_here
# TELEGRAM_CHAT_ID=your_chat_id_here

# SQLite
SESSIONS_DB_PATH=sessions.db
